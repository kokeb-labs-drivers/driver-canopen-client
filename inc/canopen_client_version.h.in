 * @file canopen_client_version.h
 * @brief CANOPEN_CLIENT driver version, generated by CMake from canopen_client_version.h.in.
 * @copyright Copyright (c) 2026 The driver-canopen-client authors. SPDX-License-Identifier: MIT
 *
 * Do not edit the generated file: the version is set once, in cmake/canopen_client_build_settings.cmake, and
 * configure_file() writes it here.
 */
#ifndef CANOPEN_CLIENT_VERSION_H
#define CANOPEN_CLIENT_VERSION_H

/** Major version: incompatible API changes. */
#define CANOPEN_CLIENT_VERSION_MAJOR @CANOPEN_CLIENT_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define CANOPEN_CLIENT_VERSION_MINOR @CANOPEN_CLIENT_VERSION_MINOR@
/** Patch version: fixes. */
#define CANOPEN_CLIENT_VERSION_PATCH @CANOPEN_CLIENT_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define CANOPEN_CLIENT_VERSION_STRING "@CANOPEN_CLIENT_VERSION@"

#endif // CANOPEN_CLIENT_VERSION_H
